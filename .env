# APP CONFIG (DO NOT REMOVE!)
APP_NAME="Wolf Kitchen"
APP_ENV=production
APP_KEY=base64:INSERTA_TU_APP_KEY_AQUI
APP_DEBUG=false
APP_URL=https://wolf-kitchen.onrender.com

IGNITER_CARTE_KEY=                     # Solo si usas el módulo Carte
IGNITER_LOCATION_MODE=multiple

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=tu-db-host.render.com
DB_PORT=3306
DB_DATABASE=wolf_kitchen_db
DB_USERNAME=wolf_admin
DB_PASSWORD=tu_contraseña_segura
DB_PREFIX=

# CACHE & SESSION
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# REDIS (opcional, no usado por defecto)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL CONFIG
MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@wolfkitchen.mx
MAIL_FROM_NAME="Wolf Kitchen"
